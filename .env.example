# ==============================================================================
# LEGITIFY ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Duplicate this file to .env.local and populate with your credentials.
# DO NOT COMMIT REAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# Server & API Ports
PORT=3001
VITE_API_URL=http://localhost:3001

# Supabase PostgreSQL & Auth
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_private_key_here
SUPABASE_STORAGE_BUCKET=legitify-files

# Direct PostgreSQL Database URL (Optional for direct ORM access)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# Google Gemini API Key (Powers Trust AI Copilot & Live Web Grounding)
GEMINI_API_KEY=your_google_gemini_api_key_here
VITE_GEMINI_API_KEY=your_google_gemini_api_key_here
GOOGLE_AI_KEY=your_google_ai_key_here

# Google OAuth 2.0 Credentials (For Candidate Login)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Threat Intelligence Feeds (Optional)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Email Notification Service (Optional)
RESEND_API_KEY=your_resend_api_key_here
